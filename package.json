{
  "name": "hermes-harness-with-missioncontrol",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter './packages/**' build && pnpm -r typecheck",
    "dev:console": "pnpm --filter harness-console dev",
    "dev:console:auth": "sh -c 'VITE_OPERATOR_TOKEN=${VITE_OPERATOR_TOKEN:?set VITE_OPERATOR_TOKEN to the same value as HARNESS_OPERATOR_TOKEN} pnpm --filter harness-console dev'",
    "dev:memory": "pnpm --filter memory-api dev",
    "dev:orchestrator": "pnpm --filter orchestrator-api dev",
    "dev:eval": "pnpm --filter eval-api dev",
    "dev:worker": "pnpm --filter worker-runtime dev",
    "dev:reset-state": "rm -f data/orchestrator-state.json data/eval-state.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
