# Daily Brief Runner — required secrets
# Copy to .env locally; never commit real values.
# Any var left unset will degrade that section to a stub line (workflow still runs end-to-end).

# ─── Schedule ────────────────────────────────────────────────────────────────
# Cron expression (server local time). Default 7:00 AM every day.
DAILY_BRIEF_CRON="0 7 * * *"
# Timezone for the cron (IANA). Default America/Los_Angeles.
DAILY_BRIEF_TZ="America/Los_Angeles"
# HTTP port for the runner (manual-trigger + health endpoints).
PORT=4305

# ─── Google (Calendar + Gmail) ───────────────────────────────────────────────
# Either OAuth refresh token flow OR service-account JSON path.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: comma-separated calendar IDs (default: "primary")
GOOGLE_CALENDAR_IDS="primary"
# Gmail: comma-separated label names to treat as "urgent" (default: INBOX with is:starred OR is:important)
GMAIL_URGENT_LABELS=""
GMAIL_URGENT_MAX=5

# ─── Weather (OpenWeatherMap) ────────────────────────────────────────────────
OPENWEATHER_API_KEY=
# Lat/lon for forecast (decimal degrees). Default: SF Bay Area.
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194

# ─── Interest feeds ──────────────────────────────────────────────────────────
# Comma-separated RSS URLs. The runner picks the top 3 most recent.
FEEDS_RSS_URLS=""
# Optional X bearer for a curated list — list_id is the numeric Twitter list ID.
X_BEARER_TOKEN=""
X_LIST_ID=""

# ─── Delivery (Telegram) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Behavior ────────────────────────────────────────────────────────────────
# When true, prints the brief to stdout instead of sending to Telegram.
DAILY_BRIEF_DRY_RUN=false
